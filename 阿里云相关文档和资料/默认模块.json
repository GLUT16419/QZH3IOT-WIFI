    {
      "identifier": "get",
      "name": "get",
      "required": true,
      "callType": "async",
      "desc": "属性获取",
      "method": "thing.service.property.get",
      "inputData": [
        "temperature",
        "Humidity"
      ],
      "outputData": [
        {
          "identifier": "temperature",
          "name": "温度",
          "dataType": {
            "type": "float",
            "specs": {
              "min": "0",
              "max": "100",
              "unit": "°C",
              "unitName": "摄氏度",
              "step": "0.1"
            }
          }
        },
        {
          "identifier": "Humidity",
          "name": "湿度",
          "dataType": {
            "type": "float",
            "specs": {
              "min": "0",
              "max": "100",
              "unit": "%RH",
              "unitName": "相对湿度",
              "step": "0.1"
            }
          }
        }
